---
import "../styles/global.css";
import PencilThread from "../components/PencilThread.astro";
import { SITE_URL } from "../config/site";
import { LANGS, getT, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  /** Ruta dentro del idioma, sin barra inicial ("install/"); vacío en la portada. */
  path?: string;
  title?: string;
  description?: string;
  /** Páginas aún sin diseño: fuera de los buscadores. */
  noindex?: boolean;
  /** El hilo de lápiz solo existe en la portada. */
  thread?: boolean;
}

const { lang, path = "", title, description, noindex = false, thread = true } = Astro.props;
const t = getT(lang);
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const canonical = new URL(`/${lang}/${path}`, SITE_URL).href;
const ogImage = new URL(`/og/${lang}.png`, SITE_URL).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#FFFDF4" />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(`/${l}/${path}`, SITE_URL).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(path ? `/en/${path}` : "/", SITE_URL).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Solo las fuentes del hero: Nunito 900 (variable) y Excalifont -->
    <link rel="preload" href="/fonts/nunito-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/excalifont-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="aline" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "es" ? "en_US" : "es_ES"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <slot />
    {thread && <PencilThread />}
  </body>
</html>

---
/*
 * Página provisional (Instalar, Acerca de, Términos, Privacidad): la estructura completa con nav y
 * footer, y una hoja en blanco que avisa de que el diseño llega más adelante.
 */
import Base from "../layouts/Base.astro";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import DrawnButton from "./DrawnButton.astro";
import washiYellow from "../assets/landing/doodles/washi-tape-yellow.svg";
import washiPink from "../assets/landing/doodles/washi-tape-pink.svg";
import dotGrid from "../assets/landing/patterns/dot-grid-paper.svg";
import type { PageSlug } from "../config/site";
import { getT, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  slug: PageSlug;
}

const { lang, slug } = Astro.props;
const t = getT(lang);
const page = t.pages[slug];
const path = `${slug}/`;
---

<Base lang={lang} {path} title={`${page.title} — aline`} noindex thread={false}>
  <Nav lang={lang} {path} />
  <main class="blank">
    <div class="container">
      <h1 class="blank__title">{page.title}</h1>

      <div class="blank__sheet" style={`--dot-grid: url("${dotGrid.src}")`}>
        <img class="blank__tape blank__tape--left" src={washiYellow.src} width="150" height="32" alt="" />
        <img class="blank__tape blank__tape--right" src={washiPink.src} width="150" height="32" alt="" />
        <p class="blank__body hand">{page.body}</p>
        <p class="blank__soon note" aria-hidden="true">
          {t.pages.soon}
        </p>
      </div>

      <DrawnButton href={`/${lang}/`} variant="secondary" size="lg">
        {t.pages.back}
      </DrawnButton>
    </div>
  </main>
  <Footer lang={lang} {path} />
</Base>

<style>
  .blank {
    position: relative;
    z-index: 1;
    /* debajo del logo y de la libreta flotantes */
    padding-block: 176px 120px;
  }

  .blank__title {
    max-width: 900px;
    margin: 0 0 40px;
    font-weight: 900;
    font-size: clamp(40px, 6vw, 84px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .blank__sheet {
    position: relative;
    max-width: 900px;
    min-height: 340px;
    margin-bottom: 48px;
    padding: 56px 56px 48px;
    border: 2px solid var(--border-ink);
    border-radius: 20px;
    background-color: var(--bg-canvas);
    background-image: var(--dot-grid);
    background-size: 24px 24px;
    box-shadow: 0 8px 0 var(--border-soft);
  }

  .blank__tape {
    position: absolute;
    top: -6px;
    width: 150px;
    height: 32px;
    pointer-events: none;
  }

  .blank__tape--left {
    left: -42px;
    transform: rotate(-38deg);
  }

  .blank__tape--right {
    right: -42px;
    transform: rotate(38deg);
  }

  .blank__body {
    margin: 0 0 28px;
    font-size: 34px;
    line-height: 1.5;
  }

  .blank__soon {
    margin: 0;
    font-size: 22px;
    text-decoration: underline;
    text-decoration-color: rgba(138, 90, 0, 0.5);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 6px;
  }

  @media (max-width: 599.98px) {
    .blank {
      padding-block: 150px 80px;
    }

    .blank__sheet {
      padding: 44px 24px 32px;
    }

    .blank__body {
      font-size: 24px;
    }

    .blank__tape {
      width: 110px;
      height: 24px;
    }

    .blank__tape--left {
      left: -30px;
    }

    .blank__tape--right {
      right: -30px;
    }
  }
</style>

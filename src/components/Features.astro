---
/*
 * "Un hilo que lo une todo": cuatro notas adhesivas unidas por enlaces a lápiz.
 * Misma construcción que las notas de la app: contorno de tinta, banda adhesiva y esquina doblada.
 */
import notesIcon from "../assets/landing/icons/notes.svg?raw";
import docsIcon from "../assets/landing/icons/docs.svg?raw";
import diagramsIcon from "../assets/landing/icons/diagrams.svg?raw";
import calendarIcon from "../assets/landing/icons/calendar.svg?raw";
import noteLink from "../assets/landing/notes/note-link.svg?raw";
import { getT, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getT(lang).ways;

// Cuerpo, banda/doblez y giro de cada nota (decoración: los colores de sticker no indican estado)
const notes = [
  { ...t.notes, icon: notesIcon, fill: "#FFE380", band: "#F7D766", tilt: -2.2 },
  { ...t.docs, icon: docsIcon, fill: "#BFDFE2", band: "#A8D1D5", tilt: 1.6 },
  { ...t.diagrams, icon: diagramsIcon, fill: "#F7AFCB", band: "#F09DBE", tilt: -1.2 },
  { ...t.calendar, icon: calendarIcon, fill: "#A8D5A2", band: "#95C98E", tilt: 2.4 },
];

// Esquina doblada (notes/note-fold.svg), rellena con el color de banda de cada nota
const FOLD = "M33.2 0.8 L0.8 33.2 Q1.4 8 2.6 2.6 Q8 1.4 33.2 0.8 Z";
---

<section class="section" id="features" aria-labelledby="ways-title">
  <div class="container">
    <h2 class="section__title" id="ways-title" data-thread-anchor="ways">
      {t.title}
    </h2>
    <p class="section__sub">{t.sub}</p>

    <div class="notes" data-thread-anchor="ways-end">
      {notes.map((n, i) => (
        <article
          class="sticky"
          style={`--fill: ${n.fill}; --band: ${n.band}; --tilt: ${n.tilt}deg`}
          aria-labelledby={`way-${i}`}
        >
          <div class="sticky__ink">
            <div class="sticky__fill">
              <span class="sticky__band" aria-hidden="true" />
              <div class="sticky__head">
                <span class="sticky__icon icon" set:html={n.icon} />
                <h3 class="sticky__title" id={`way-${i}`}>
                  {n.title}
                </h3>
              </div>
              <p class="sticky__body">{n.body}</p>
              <span class="sticky__tag" aria-hidden="true">
                {n.note}
              </span>
            </div>
          </div>
          <svg class="sticky__fold" viewBox="0 0 34 34" width="34" height="34" aria-hidden="true">
            <path d={FOLD} />
          </svg>
          {i < notes.length - 1 && (
            <span
              class:list={["sticky__link", { "sticky__link--flip": i % 2 === 1 }]}
              aria-hidden="true"
              set:html={noteLink}
            />
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .notes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 44px;
    /* que el giro no se corte */
    padding-inline: 6px;
  }

  .sticky {
    position: relative;
    display: flex;
    transform: rotate(var(--tilt));
    /* drop-shadow y no box-shadow: la sombra tiene que seguir la esquina cortada */
    filter: drop-shadow(0 2px 1px rgba(80, 55, 20, 0.14)) drop-shadow(0 12px 10px rgba(80, 55, 20, 0.16));
    transition:
      transform 250ms var(--ease-out),
      filter 250ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .sticky:hover {
      transform: rotate(0deg) translateY(-5px);
      filter: drop-shadow(0 3px 2px rgba(80, 55, 20, 0.14)) drop-shadow(0 20px 16px rgba(80, 55, 20, 0.2));
    }
  }

  /* Contorno: la tinta con 1.5px de padding hace de borde; los dos recortes dejan 1.5px también en la diagonal */
  .sticky__ink {
    flex: 1;
    display: flex;
    padding: 1.5px;
    background: var(--text-primary);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 34px), calc(100% - 34px) 100%, 0 100%);
  }

  .sticky__fill {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 300px;
    padding: 54px 24px 42px;
    background: var(--fill);
    color: var(--text-primary);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 31.9px), calc(100% - 31.9px) 100%, 0 100%);
  }

  .sticky__band {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 34px;
    background: var(--band);
  }

  .sticky__head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .sticky__icon {
    width: 26px;
    height: 26px;
    color: var(--text-primary);
  }

  .sticky__title {
    margin: 0;
    font-family: var(--font-hand);
    font-weight: 400;
    font-size: 32px;
    line-height: 1.05;
  }

  .sticky__body {
    margin: 0 0 18px;
    font-family: var(--font-hand);
    font-size: 21px;
    line-height: 1.35;
  }

  .sticky__tag {
    margin-top: auto;
    font-family: var(--font-hand);
    font-size: 18px;
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-color: rgba(38, 33, 24, 0.55);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
  }

  .sticky__fold {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 34px;
    height: 34px;
    overflow: visible;
  }

  .sticky__fold path {
    fill: var(--band);
    stroke: var(--text-primary);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  /* Enlace a lápiz con la nota siguiente: por encima de su nota y por debajo de la siguiente */
  .sticky__link {
    position: absolute;
    right: -54px;
    top: 46%;
    z-index: 1;
    width: 64px;
    height: 30px;
    pointer-events: none;
  }

  .sticky__link :global(svg) {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .sticky__link--flip {
    transform: scaleY(-1);
  }

  @media (max-width: 1179.98px) {
    .sticky__link {
      display: none;
    }
  }

  @media (max-width: 959.98px) {
    .notes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 599.98px) {
    .notes {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky {
      transition: filter 250ms var(--ease-out);
    }
  }
</style>

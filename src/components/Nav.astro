---
import DrawnButton from "./DrawnButton.astro";
import LangSwitch from "./LangSwitch.astro";
import Sticker from "./Sticker.astro";
import alinePencil from "../assets/landing/logo/aline-pencil.svg";
import arrowRaw from "../assets/landing/doodles/arrow-curve-up-left.svg?raw";
import { APP_URL, INSTALL_URL } from "../config/site";
import { getT, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getT(lang);
---

<header class="nav">
  <div class="container nav__inner">
    <div class="nav__slot" data-sticker-slot>
      <Sticker label={t.sticker.aria} />
      <a class="nav__pencil" href="#top" tabindex="-1" data-sticker-under>
        <img src={alinePencil.src} width="120" height="44" alt="aline" />
      </a>
      <p class="nav__hint hand" aria-hidden="true">
        <span class="nav__hint-arrow" set:html={arrowRaw} />
        {t.sticker.hint}
      </p>
      <!-- Aplica el estado guardado del sticker antes del primer pintado: sin esto, el aviso y el
           sticker se ven un instante en la ranura hasta que carga la isla (misma lógica que Sticker.astro) -->
      <script is:inline>
        (function () {
          try {
            const s = JSON.parse(localStorage.getItem("aline.sticker") || "null");
            if (!s || !isFinite(s.x) || !isFinite(s.y)) return;
            const maxX = document.documentElement.clientWidth - 140 + 4 - 8;
            const maxY = window.innerHeight - 60 + 4 - 8;
            if (s.x < 4 || s.y < 4 || s.x > maxX || s.y > maxY) return;
            const slot = document.currentScript.parentElement;
            const el = slot.querySelector("[data-sticker]");
            slot.classList.add("is-peeled");
            el.classList.add("is-loose");
            el.style.left = s.x + "px";
            el.style.top = s.y + "px";
            el.style.transform = "rotate(" + (isFinite(s.rot) ? s.rot : 0) + "deg) scale(1)";
          } catch {
            /* sin almacenamiento: se queda en la ranura */
          }
        })();
      </script>
    </div>

    <nav class="nav__links" aria-label={t.nav.label}>
      <a href="#features">{t.nav.features}</a>
      <a href="#pencil">{t.nav.pencil}</a>
      <a href="#why">{t.nav.why}</a>
    </nav>

    <div class="nav__actions">
      <LangSwitch lang={lang} />
      <DrawnButton class="nav__install" href={INSTALL_URL} variant="secondary">
        {t.nav.install}
      </DrawnButton>
      <DrawnButton href={APP_URL} variant="primary">
        {t.cta.open}
      </DrawnButton>
    </div>
  </div>
</header>

<style>
  /* Sin backdrop-filter, transform ni filter aquí: romperían el position: fixed del sticker */
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    height: 76px;
    background: var(--bg-canvas);
    border-bottom: 1.5px solid var(--border-soft);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 100%;
  }

  .nav__slot {
    position: relative;
    flex: none;
    width: 132px;
    height: 52px;
  }

  .nav__pencil {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-sm);
  }

  .nav__pencil img {
    width: 120px;
    height: 44px;
  }

  .nav__hint {
    position: absolute;
    top: calc(100% + 14px);
    left: 70px;
    display: flex;
    align-items: flex-start;
    gap: 2px;
    margin: 0;
    padding: 4px 10px 4px 4px;
    /* Cae sobre el escritorio pintado: un trozo de papel mantiene el contraste */
    background: var(--bg-canvas);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sticker);
    color: var(--text-accent);
    font-size: 19px;
    line-height: 1;
    white-space: nowrap;
    pointer-events: none;
    transform: rotate(-3deg);
  }

  .nav__hint-arrow {
    display: block;
    width: 34px;
    height: 30px;
    margin-top: -18px;
  }

  .nav__slot.is-peeled .nav__hint {
    display: none;
  }

  .nav__links {
    display: flex;
    gap: 8px;
  }

  .nav__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 10px;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
  }

  @media (hover: hover) {
    .nav__links a:hover {
      background: var(--selection-soft);
    }
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-left: auto;
  }

  @media (max-width: 959.98px) {
    .nav__links {
      display: none;
    }
  }

  @media (max-width: 599.98px) {
    .nav__inner {
      padding-inline: 16px;
      gap: 12px;
    }

    .nav__actions {
      gap: 6px;
    }

    .nav__actions :global(.nav__install) {
      display: none;
    }
  }
</style>

---
/*
 * Nav flotante: dos objetos de papel fijos sobre la página, sin franja.
 * - Arriba a la izquierda, el logo: el sticker pegado sobre su hoja de respaldo, con "aline" a lápiz debajo.
 * - Arriba a la derecha, una hoja de libreta con el idioma y los CTAs, que se va con el scroll.
 */
import DrawnButton from "./DrawnButton.astro";
import LangSwitch from "./LangSwitch.astro";
import Sticker from "./Sticker.astro";
import alinePencil from "../assets/landing/logo/aline-pencil.svg";
import sticker from "../assets/landing/logo/aline-sticker.svg";
import stickerPeeling from "../assets/landing/logo/aline-sticker-peeling.svg";
import backing from "../assets/landing/logo/sticker-backing.svg";
import notebookEdge from "../assets/landing/nav/notebook-edge.svg";
import washiYellow from "../assets/landing/doodles/washi-tape-yellow.svg";
import arrowRaw from "../assets/landing/doodles/arrow-curve-up-left.svg?raw";
import { APP_URL, INSTALL_URL, NAV_PAPER_RETURN } from "../config/site";
import { getT, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getT(lang);
---

<header class="nav">
  <!-- Sin transform ni filter en .logo-dock: el sticker suelto es position: fixed y tiene que
       resolverse contra el viewport. Solo los hijos van girados. -->
  <div class="logo-dock" data-sticker-slot>
    <img class="logo-dock__backing" src={backing.src} width="164" height="80" alt="" />
    <span class="logo-dock__die" data-sticker-die aria-hidden="true"></span>
    <a class="logo-dock__pencil" href="#top" tabindex="-1" data-sticker-under>
      <img src={alinePencil.src} width="120" height="44" alt="aline" />
    </a>
    <Sticker
      class="logo-dock__sticker"
      label={t.sticker.aria}
      rest={sticker.src}
      peel={stickerPeeling.src}
      width={140}
      height={60}
      storageKey="aline.sticker"
      rotate={-2}
      insetRatio={4 / 140}
      click="top"
    />
    <p class="logo-dock__hint hand" aria-hidden="true">
      <span class="logo-dock__arrow">
        <span class="logo-dock__arrow-halo" set:html={arrowRaw} />
        <span set:html={arrowRaw} />
      </span>
      {t.sticker.hint}
    </p>
  </div>

  <nav class="paper" aria-label={t.nav.label} data-nav-paper data-return={NAV_PAPER_RETURN}>
    <img class="paper__edge" src={notebookEdge.src} width="40" height="118" alt="" />
    <div class="paper__body">
      <img class="paper__tape" src={washiYellow.src} width="96" height="26" alt="" />
      <div class="paper__row paper__row--lang">
        <LangSwitch lang={lang} variant="hand" />
      </div>
      <div class="paper__row paper__row--ctas">
        <DrawnButton class="paper__install" href={INSTALL_URL} variant="secondary">
          {t.nav.install}
        </DrawnButton>
        <DrawnButton href={APP_URL} variant="primary">
          {t.cta.open}
        </DrawnButton>
      </div>
    </div>
  </nav>
</header>

<script>
  const THRESHOLD = 40;
  const SCROLL_UP_DELTA = 4;

  const paper = document.querySelector<HTMLElement>("[data-nav-paper]");
  const dock = document.querySelector<HTMLElement>(".logo-dock");
  const mode = paper?.dataset.return === "scrollUp" ? "scrollUp" : "top";
  let lastY = window.scrollY;
  let ticking = false;

  function update() {
    ticking = false;
    const y = window.scrollY;
    if (paper) {
      let away = paper.classList.contains("is-away");
      if (y < THRESHOLD) away = false;
      else if (mode === "top") away = true;
      else if (y < lastY - SCROLL_UP_DELTA) away = false;
      else if (y > lastY + SCROLL_UP_DELTA) away = true;
      paper.classList.toggle("is-away", away);
    }
    // El aviso del sticker también se va al bajar
    dock?.classList.toggle("is-scrolled", y > THRESHOLD);
    if (Math.abs(y - lastY) > SCROLL_UP_DELTA || y < THRESHOLD) lastY = y;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  update();
</script>

<style>
  /* ── Logo: sticker sobre su hoja de respaldo ───────────────────────────── */
  .logo-dock {
    --k: 1;
    position: fixed;
    left: 20px;
    top: 16px;
    z-index: 101;
    width: calc(164px * var(--k));
    height: calc(80px * var(--k));
  }

  .logo-dock__backing,
  .logo-dock__die,
  .logo-dock__pencil {
    position: absolute;
    transform: rotate(-2deg);
  }

  .logo-dock__backing {
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: calc(14px * var(--k));
    box-shadow:
      0 1px 0 rgba(80, 55, 20, 0.12),
      0 10px 22px rgba(60, 40, 10, 0.24);
  }

  /* El troquel punteado: mismo centro que la hoja, así el giro de cada pieza coincide */
  .logo-dock__die {
    left: calc(15px * var(--k));
    top: calc(13px * var(--k));
    width: calc(134px * var(--k));
    height: calc(54px * var(--k));
    pointer-events: none;
  }

  .logo-dock__pencil {
    left: calc(22px * var(--k));
    top: calc(18px * var(--k));
    display: flex;
    width: calc(120px * var(--k));
    height: calc(44px * var(--k));
    border-radius: var(--radius-sm);
  }

  .logo-dock__pencil img {
    width: 100%;
    height: 100%;
  }

  /* El sticker pegado: centrado en el troquel (--k escala el logo en pantallas estrechas) */
  .logo-dock :global(.logo-dock__sticker) {
    left: calc(12px * var(--k));
    top: calc(10px * var(--k));
    width: calc(140px * var(--k));
    height: calc(60px * var(--k));
  }

  .logo-dock__hint {
    position: absolute;
    left: calc(78px * var(--k));
    top: calc(84px * var(--k));
    display: flex;
    align-items: flex-start;
    gap: 2px;
    margin: 0;
    color: var(--text-accent);
    font-size: 19px;
    line-height: 1;
    white-space: nowrap;
    pointer-events: none;
    /* Cae sobre el arte pintado: halo de papel */
    text-shadow:
      0 0 2px #fffdf4,
      0 0 4px #fffdf4,
      0 0 7px #fffdf4,
      0 0 12px #fffdf4;
    transform: rotate(-3deg);
    transition: opacity 200ms var(--ease-out);
  }

  .logo-dock__arrow {
    position: relative;
    display: block;
    width: 34px;
    height: 30px;
    margin-top: -18px;
  }

  .logo-dock__arrow > span {
    position: absolute;
    inset: 0;
  }

  .logo-dock__arrow :global(svg) {
    overflow: visible;
  }

  /* Debajo de la flecha, el mismo trazo en papel a 6px */
  .logo-dock__arrow-halo :global(path) {
    stroke: #fffdf4;
    stroke-width: 6px;
  }

  .logo-dock.is-peeled .logo-dock__hint,
  .logo-dock.is-scrolled .logo-dock__hint {
    opacity: 0;
  }

  /* ── Hoja de libreta ──────────────────────────────────────────────────── */
  .paper {
    position: fixed;
    right: 22px;
    top: 18px;
    z-index: 100;
    display: flex;
    /* La sombra sigue el borde arrancado; aquí el filter no rompe nada: no hay hijos fixed */
    filter: drop-shadow(0 1px 0 rgba(80, 55, 20, 0.12)) drop-shadow(0 10px 14px rgba(60, 40, 10, 0.24));
    transform: rotate(1.5deg);
    transform-origin: 70% 0;
    transition:
      transform 550ms cubic-bezier(0.2, 1.2, 0.4, 1),
      opacity 550ms cubic-bezier(0.2, 1.2, 0.4, 1),
      visibility 0s 0s;
  }

  /* Se va al bajar, como si la arrancaran; oculta de verdad para que Tab no llegue a sus botones */
  .paper.is-away {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-160%) rotate(-5deg);
    transition:
      transform 500ms cubic-bezier(0.5, 0, 0.75, 0),
      opacity 500ms cubic-bezier(0.5, 0, 0.75, 0),
      visibility 0s 500ms;
  }

  .paper__edge {
    flex: none;
    width: 40px;
    height: 118px;
    margin-right: -1px;
  }

  .paper__body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    height: 118px;
    padding: 12px 22px 0 8px;
    border-radius: 0 16px 6px 0;
    background-color: #fbf7ea;
    /* Renglones de 1px a 48px y 108px del borde superior */
    background-image: linear-gradient(#c9d3d3, #c9d3d3), linear-gradient(#c9d3d3, #c9d3d3);
    background-size:
      100% 1px,
      100% 1px;
    background-position:
      0 48px,
      0 108px;
    background-repeat: no-repeat;
  }

  .paper__tape {
    position: absolute;
    top: -12px;
    left: 50%;
    width: 96px;
    height: 26px;
    transform: translateX(-50%) rotate(-4deg);
    pointer-events: none;
  }

  /* Renglón 1: el idioma escrito sobre la línea de 48px */
  .paper__row--lang {
    height: 36px;
    display: flex;
    align-items: flex-end;
  }

  .paper__row--lang :global(.lang) {
    margin-bottom: -6px;
  }

  /* Renglón 2: los CTAs entre las dos líneas */
  .paper__row--ctas {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 60px;
    margin-top: 0;
    padding-top: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .paper,
    .paper.is-away {
      transform: rotate(1.5deg);
      transition:
        opacity 150ms linear,
        visibility 0s 150ms;
    }

    .paper:not(.is-away) {
      transition:
        opacity 150ms linear,
        visibility 0s 0s;
    }
  }

  @media (max-width: 599.98px) {
    .logo-dock {
      left: 12px;
      top: 12px;
    }

    .paper {
      right: 12px;
      top: 14px;
    }

    .paper__row--ctas :global(.paper__install) {
      display: none;
    }

    .paper__body {
      padding-right: 16px;
    }

    /* En dos líneas, para no meterse bajo la hoja de libreta */
    .logo-dock__hint {
      max-width: 96px;
      white-space: normal;
      line-height: 1.05;
    }
  }

  /* El logo completo (164px) y la hoja chocan: el logo se reduce cambiando tamaños, no con transform */
  @media (max-width: 399.98px) {
    .logo-dock {
      --k: 0.85;
    }

    .logo-dock__hint {
      font-size: 17px;
    }
  }
</style>

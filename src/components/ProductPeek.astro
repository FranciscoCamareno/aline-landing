---
/*
 * Vista previa del producto hecha en HTML: escala nítida, se traduce y pesa casi nada.
 * Toda la ventana es una ilustración (role="img"); nada de su interior es interactivo.
 */
import diagramsIcon from "../assets/landing/icons/diagrams.svg?raw";
import notesIcon from "../assets/landing/icons/notes.svg?raw";
import { getT, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getT(lang).peek;
---

<section class="section section--after-hero peek-section">
  <div class="container">
    <div class="peek" data-thread-anchor="peek">
      <div class="peek__scroll" role="img" aria-label={t.aria} tabindex="0">
        <div class="peek__win" aria-hidden="true">
          <div class="peek__bar">
            <span class="peek__tab is-active">
              <span class="icon" set:html={diagramsIcon} />
              {t.tab1}
            </span>
            <span class="peek__tab">
              <span class="icon" set:html={notesIcon} />
              {t.tab2}
            </span>
          </div>

          <div class="peek__body">
            <div class="peek__side">
              <p class="peek__group">{t.groupNotes}</p>
              <p class="peek__item">{t.note1}</p>
              <p class="peek__item">{t.note2}</p>
              <p class="peek__item">{t.note3}</p>
              <p class="peek__group">{t.groupDocs}</p>
              <p class="peek__item">{t.docs}</p>
              <p class="peek__group">{t.groupCanvases}</p>
              <p class="peek__item is-active">
                {t.tab1}
                <span class="peek__pill">{t.open}</span>
              </p>
              <p class="peek__group">{t.groupCalendar}</p>
              <p class="peek__item">{t.calendar}</p>
            </div>

            <div class="peek__canvas">
              <svg class="peek__lines" viewBox="0 0 100 100" preserveAspectRatio="none">
                <path d="M47 50 C 40 44, 36 34, 31 26" vector-effect="non-scaling-stroke"></path>
                <path d="M52 47 C 52 36, 49 26, 47 19" vector-effect="non-scaling-stroke"></path>
                <path d="M58 48 C 63 40, 68 32, 72 24" vector-effect="non-scaling-stroke"></path>
                <path d="M46 56 C 38 64, 28 72, 21 78" vector-effect="non-scaling-stroke"></path>
                <path d="M58 56 C 63 62, 66 66, 69 70" vector-effect="non-scaling-stroke"></path>
              </svg>

              <div class="peek__note">
                <p class="peek__note-title">{t.note1}</p>
                <p class="peek__note-body">{t.noteBody}</p>
                <p class="peek__note-link">[[{t.chapter}]]</p>
              </div>

              <div class="peek__node">{t.chapter}</div>

              <p class="peek__sticky peek__sticky--agua">{t.sticky1}</p>
              <p class="peek__sticky peek__sticky--rosa">{t.sticky2}</p>
              <p class="peek__sticky peek__sticky--brote">{t.sticky3}</p>

              <div class="peek__event">
                <span class="peek__date">
                  <span>{t.day}</span>
                  <strong>14</strong>
                </span>
                <span class="peek__event-text">
                  <strong>{t.due}</strong>
                  <span>{t.chapter}</span>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <p class="peek__swipe note" aria-hidden="true">
        {t.swipe}
      </p>
    </div>
  </div>
</section>

<style>
  .peek__scroll {
    border-radius: var(--radius-lg);
  }

  .peek__win {
    overflow: hidden;
    border: 2px solid var(--border-ink);
    border-radius: var(--radius-lg);
    background: var(--bg-panel);
    box-shadow: 0 8px 0 var(--border-soft);
  }

  .peek__bar {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    padding: 12px 16px 0;
    border-bottom: 2px solid var(--border-ink);
  }

  .peek__tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: -2px;
    padding: 9px 16px;
    border: 2px solid transparent;
    border-bottom: 0;
    border-radius: 12px 12px 0 0;
    color: var(--text-secondary);
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
  }

  .peek__tab.is-active {
    border-color: var(--border-soft);
    background: var(--bg-canvas);
    color: var(--text-primary);
  }

  .peek__tab .icon {
    width: 16px;
    height: 16px;
  }

  .peek__body {
    display: flex;
  }

  .peek__side {
    flex: none;
    width: 220px;
    padding: 18px 14px;
    border-right: 1.5px solid var(--border-soft);
  }

  .peek__side p {
    margin: 0;
  }

  .peek__group {
    margin-top: 16px !important;
    padding: 0 8px 4px;
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 800;
  }

  .peek__group:first-child {
    margin-top: 0 !important;
  }

  .peek__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    padding: 5px 8px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }

  .peek__item.is-active {
    background: var(--selection-soft);
  }

  .peek__pill {
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--secondary-soft);
    color: var(--on-secondary);
    font-size: 11px;
    font-weight: 800;
  }

  .peek__canvas {
    position: relative;
    flex: 1;
    min-width: 680px;
    height: 470px;
    background-color: var(--bg-canvas);
    background-image: radial-gradient(var(--border-soft) 1.2px, transparent 1.4px);
    background-size: 24px 24px;
  }

  .peek__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    overflow: visible;
  }

  .peek__lines path {
    fill: none;
    stroke: var(--border-ink);
    stroke-width: 1.8px;
    stroke-linecap: round;
  }

  .peek__note {
    position: absolute;
    left: 4%;
    top: 7%;
    width: 30%;
    min-width: 200px;
    padding: 14px 16px;
    border: 2px solid var(--border-ink);
    border-radius: var(--radius-sm);
    background: var(--bg-canvas);
  }

  .peek__note p {
    margin: 0;
  }

  .peek__note-title {
    font-size: 14px;
    font-weight: 900;
  }

  .peek__note-body {
    margin: 6px 0 !important;
    color: var(--text-secondary);
    font-size: 12.5px;
    line-height: 1.45;
  }

  .peek__note-link {
    /* --link sobre papel da 4.47:1; a 12.5px hace falta el agua más oscura para AA */
    color: var(--on-secondary);
    font-size: 12.5px;
    font-weight: 800;
  }

  .peek__node {
    position: absolute;
    left: 50%;
    top: 52%;
    padding: 12px 22px;
    border: 2px solid var(--border-ink);
    border-radius: 999px;
    background: var(--brand);
    color: var(--on-brand);
    font-size: 16px;
    font-weight: 900;
    white-space: nowrap;
    transform: translate(-50%, -50%) rotate(-2deg);
  }

  .peek__sticky {
    position: absolute;
    width: 132px;
    margin: 0;
    padding: 14px 12px;
    color: var(--text-primary);
    font-family: var(--font-hand);
    font-size: 17px;
    line-height: 1.2;
    box-shadow: var(--shadow-sticker);
  }

  .peek__sticky--agua {
    left: 41%;
    top: 4%;
    background: var(--sticker-agua);
    transform: rotate(-4deg);
  }

  .peek__sticky--rosa {
    left: 70%;
    top: 9%;
    background: var(--sticker-rosa);
    transform: rotate(3deg);
  }

  .peek__sticky--brote {
    left: 9%;
    top: 72%;
    background: var(--sticker-brote);
    transform: rotate(-2deg);
  }

  .peek__event {
    position: absolute;
    left: 64%;
    top: 68%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px 10px 10px;
    border: 2px solid var(--border-ink);
    border-radius: var(--radius-sm);
    background: var(--secondary-soft);
  }

  .peek__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 46px;
    padding: 4px 6px;
    border: 2px solid var(--border-ink);
    border-radius: 8px;
    background: var(--bg-canvas);
    font-size: 11px;
    font-weight: 800;
    line-height: 1.1;
  }

  .peek__date strong {
    font-size: 20px;
    font-weight: 900;
  }

  .peek__event-text {
    display: flex;
    flex-direction: column;
    font-size: 12.5px;
    white-space: nowrap;
  }

  .peek__event-text strong {
    font-size: 14px;
    font-weight: 900;
  }

  .peek__event-text span {
    color: var(--on-secondary);
    font-weight: 700;
  }

  .peek__swipe {
    display: none;
    margin: 10px 0 0;
    text-align: right;
  }

  @media (max-width: 959.98px) {
    .peek__scroll {
      overflow-x: auto;
      /* deja ver la sombra plana */
      padding-bottom: 10px;
    }

    .peek__win {
      width: max-content;
    }

    .peek__side {
      display: none;
    }

    .peek__swipe {
      display: block;
    }
  }
</style>

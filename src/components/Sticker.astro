---
/*
 * Sticker despegable, reutilizable (el logo del nav y la "a" del footer usan este mismo código).
 *
 * Pegado vive dentro de su contenedor [data-sticker-slot] y vuelve al centro de su
 * [data-sticker-die]. Despegado pasa a position: fixed, así que ningún ancestro suyo puede llevar
 * transform, filter ni rotate. La posición y el tamaño pegado los pone el componente padre con `class`.
 */
interface Props {
  /** aria-label traducido: explica el arrastre, las flechas y cómo devolverlo. */
  label: string;
  /** Imagen en reposo y con la esquina levantada (mientras se arrastra). */
  rest: string;
  peel: string;
  /** Tamaño intrínseco de las imágenes (para reservar espacio). */
  width: number;
  height: number;
  /** Clave de localStorage para recordar dónde se dejó. */
  storageKey: string;
  /** Giro en reposo dentro de su ranura, en grados. */
  rotate?: number;
  /** Margen transparente de la imagen alrededor del sticker visible, como fracción del ancho. */
  insetRatio?: number;
  /** Qué hace un clic sin arrastrar estando pegado. */
  click?: "top" | "none";
  /** Sombras (drop-shadow, siguen la silueta troquelada) en reposo y al levantarlo. */
  shadow?: string;
  shadowLift?: string;
  class?: string;
}

const {
  label,
  rest,
  peel,
  width,
  height,
  storageKey,
  rotate = 0,
  insetRatio = 0,
  click = "none",
  shadow = "drop-shadow(0 3px 0 rgba(38, 33, 24, 0.14))",
  shadowLift = "drop-shadow(0 16px 14px rgba(38, 33, 24, 0.22)) drop-shadow(0 2px 0 rgba(38, 33, 24, 0.1))",
  class: className,
} = Astro.props;

const vars = `--sticker-rot: ${rotate}deg; --sticker-shadow: ${shadow}; --sticker-shadow-lift: ${shadowLift}`;
---

<button
  class:list={["sticker", className]}
  type="button"
  aria-label={label}
  style={vars}
  data-sticker
  data-key={storageKey}
  data-rot={rotate}
  data-inset={insetRatio}
  data-click={click}
>
  <img class="sticker__img sticker__img--rest" src={rest} width={width} height={height} alt="" draggable="false" />
  <img class="sticker__img sticker__img--peel" src={peel} width={width} height={height} alt="" draggable="false" />
</button>
<!-- Aplica la posición guardada antes del primer pintado: sin esto, el sticker (y el aviso del nav)
     se verían un instante en su ranura hasta que carga la isla -->
<script is:inline>
  (function () {
    const el = document.currentScript.previousElementSibling;
    try {
      const s = JSON.parse(localStorage.getItem(el.dataset.key) || "null");
      if (!s || !isFinite(s.x) || !isFinite(s.y)) return;
      const inset = el.offsetWidth * (parseFloat(el.dataset.inset) || 0);
      const maxX = document.documentElement.clientWidth - el.offsetWidth + inset - 8;
      const maxY = window.innerHeight - el.offsetHeight + inset - 8;
      if (s.x < 8 - inset || s.y < 8 - inset || s.x > maxX || s.y > maxY) return;
      const slot = el.closest("[data-sticker-slot]");
      if (slot) slot.classList.add("is-peeled");
      el.classList.add("is-loose");
      el.style.left = s.x + "px";
      el.style.top = s.y + "px";
      el.style.transform = "rotate(" + (isFinite(s.rot) ? s.rot : 0) + "deg) scale(1)";
    } catch {
      /* sin almacenamiento: se queda en su ranura */
    }
  })();
</script>

<script>
  const EDGE = 8;
  const DRAG_THRESHOLD = 5;
  const RETURN_MS = 400;

  type Saved = { x: number; y: number; rot: number };

  const store = {
    get<T>(key: string): T | null {
      try {
        const raw = localStorage.getItem(key);
        return raw ? (JSON.parse(raw) as T) : null;
      } catch {
        return null;
      }
    },
    set(key: string, value: unknown) {
      try {
        if (value === null) localStorage.removeItem(key);
        else localStorage.setItem(key, JSON.stringify(value));
      } catch {
        /* sin almacenamiento: el sticker funciona igual, solo no recuerda */
      }
    },
  };

  const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));
  const randomTilt = () => Math.round((Math.random() * 16 - 8) * 10) / 10;

  function init(el: HTMLButtonElement) {
    const slot = el.closest<HTMLElement>("[data-sticker-slot]");
    if (!slot) return;
    const STORE_KEY = el.dataset.key ?? "aline.sticker";
    const DOCK_ROT = Number(el.dataset.rot) || 0;
    const INSET_RATIO = Number(el.dataset.inset) || 0;
    const clickAction = el.dataset.click ?? "none";
    // A dónde vuelve: el centro de su ranura (el troquel en el nav, la marca en el footer)
    const die = slot.querySelector<HTMLElement>("[data-sticker-die]") ?? slot;
    const underLink = slot.querySelector<HTMLAnchorElement>("[data-sticker-under]");

    let loose = false;
    let x = 0;
    let y = 0;
    let rot = DOCK_ROT;
    let scale = 1;
    let returning = false;

    // Arrastre
    let pointerId: number | null = null;
    let startX = 0;
    let startY = 0;
    let offX = 0;
    let offY = 0;
    let dragging = false;
    let suppressClick = false;
    let tilt = 0;
    let tiltTarget = 0;
    let raf = 0;

    const size = () => ({ w: el.offsetWidth, h: el.offsetHeight });
    const inset = () => el.offsetWidth * INSET_RATIO;

    function bounds() {
      const { w, h } = size();
      const INSET = inset();
      const vw = document.documentElement.clientWidth;
      const vh = window.innerHeight;
      return {
        minX: EDGE - INSET,
        minY: EDGE - INSET,
        maxX: vw - w + INSET - EDGE,
        maxY: vh - h + INSET - EDGE,
      };
    }

    function render() {
      el.style.transform = `rotate(${rot + tilt}deg) scale(${scale})`;
      if (loose) {
        el.style.left = `${x}px`;
        el.style.top = `${y}px`;
      }
    }

    function setLoose(value: boolean) {
      loose = value;
      el.classList.toggle("is-loose", value);
      if (underLink) underLink.tabIndex = value ? 0 : -1;
      if (!value) {
        el.style.left = "";
        el.style.top = "";
      }
    }

    /** Oculta el aviso de su ranura (si tiene); vuelve en la siguiente carga si está pegado. */
    function markPeeled() {
      slot!.classList.add("is-peeled");
    }

    function save() {
      store.set(STORE_KEY, loose ? ({ x, y, rot } satisfies Saved) : null);
    }

    /** Pasa de la ranura a position: fixed sin que se mueva en pantalla. */
    function peel() {
      if (loose) return;
      const r = el.getBoundingClientRect();
      // getBoundingClientRect incluye la rotación; el centro no cambia con ella.
      const { w, h } = size();
      x = r.left + r.width / 2 - w / 2;
      y = r.top + r.height / 2 - h / 2;
      el.style.transition = "none";
      setLoose(true);
      render();
      markPeeled();
    }

    function moveTo(nx: number, ny: number) {
      const b = bounds();
      x = clamp(nx, b.minX, Math.max(b.minX, b.maxX));
      y = clamp(ny, b.minY, Math.max(b.minY, b.maxY));
    }

    function settle() {
      scale = 1;
      tilt = 0;
      tiltTarget = 0;
      rot = randomTilt();
      el.classList.remove("is-lifted");
      el.style.transition = "";
      el.classList.add("is-settling");
      render();
      save();
    }

    function stickBack() {
      if (!loose || returning) return;
      returning = true;
      // Centro de la ranura (el giro no mueve el centro del rectángulo)
      const r = die.getBoundingClientRect();
      const { w, h } = size();
      x = r.left + r.width / 2 - w / 2;
      y = r.top + r.height / 2 - h / 2;
      rot = DOCK_ROT;
      scale = 1;
      tilt = 0;
      el.classList.remove("is-lifted", "is-settling");
      el.classList.add("is-returning");
      render();
      window.setTimeout(() => {
        el.classList.remove("is-returning");
        el.style.transition = "none";
        setLoose(false);
        render();
        // fuerza el estilo antes de devolver las transiciones
        void el.offsetWidth;
        el.style.transition = "";
        returning = false;
        save();
      }, RETURN_MS);
    }

    function tiltLoop() {
      tilt += (tiltTarget - tilt) * 0.25;
      tiltTarget *= 0.85;
      render();
      if (dragging) raf = requestAnimationFrame(tiltLoop);
    }

    el.addEventListener("pointerdown", (e) => {
      if (e.button !== 0 || returning) return;
      pointerId = e.pointerId;
      el.setPointerCapture(e.pointerId);
      startX = e.clientX;
      startY = e.clientY;
      dragging = false;
    });

    el.addEventListener("pointermove", (e) => {
      if (e.pointerId !== pointerId) return;
      if (!dragging) {
        if (Math.hypot(e.clientX - startX, e.clientY - startY) <= DRAG_THRESHOLD) return;
        peel();
        offX = startX - x;
        offY = startY - y;
        dragging = true;
        scale = 1.07;
        el.classList.remove("is-settling");
        el.classList.add("is-lifted");
        el.style.transition = "none";
        raf = requestAnimationFrame(tiltLoop);
      }
      tiltTarget = clamp(e.movementX * 1.4, -14, 14);
      moveTo(e.clientX - offX, e.clientY - offY);
    });

    const endDrag = (e: PointerEvent) => {
      if (e.pointerId !== pointerId) return;
      pointerId = null;
      if (!dragging) return;
      dragging = false;
      suppressClick = true;
      cancelAnimationFrame(raf);
      settle();
    };
    el.addEventListener("pointerup", endDrag);
    el.addEventListener("pointercancel", endDrag);

    el.addEventListener("click", () => {
      if (suppressClick) {
        suppressClick = false;
        return;
      }
      if (!loose && clickAction === "top") {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
      }
    });

    el.addEventListener("dblclick", () => stickBack());

    el.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        if (loose) {
          e.preventDefault();
          stickBack();
        }
        return;
      }
      const step = e.shiftKey ? 64 : 20;
      const delta: Record<string, [number, number]> = {
        ArrowLeft: [-step, 0],
        ArrowRight: [step, 0],
        ArrowUp: [0, -step],
        ArrowDown: [0, step],
      };
      const d = delta[e.key];
      if (!d || returning) return;
      e.preventDefault();
      if (!loose) {
        peel();
        rot = randomTilt();
      }
      el.style.transition = "";
      el.classList.add("is-settling");
      moveTo(x + d[0], y + d[1]);
      render();
      save();
    });

    window.addEventListener("resize", () => {
      if (!loose || dragging || returning) return;
      moveTo(x, y);
      render();
      save();
    });

    // Estado inicial
    const saved = store.get<Saved>(STORE_KEY);
    if (saved && Number.isFinite(saved.x) && Number.isFinite(saved.y)) {
      const b = bounds();
      const fits = saved.x >= b.minX && saved.x <= b.maxX && saved.y >= b.minY && saved.y <= b.maxY;
      if (fits) {
        x = saved.x;
        y = saved.y;
        rot = Number.isFinite(saved.rot) ? saved.rot : 0;
        el.style.transition = "none";
        setLoose(true);
        markPeeled();
        render();
        void el.offsetWidth;
        el.style.transition = "";
      } else {
        store.set(STORE_KEY, null);
        setLoose(false);
        render();
      }
    } else {
      setLoose(false);
      render();
    }
    el.classList.add("is-ready");
  }

  for (const el of document.querySelectorAll<HTMLButtonElement>("[data-sticker]")) init(el);
</script>

<style>
  /* La posición y el tamaño pegado los pone el padre con `class` */
  .sticker {
    position: absolute;
    z-index: 2;
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    background: none;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    transform: rotate(var(--sticker-rot, 0deg));
    transform-origin: 50% 50%;
  }

  .sticker.is-loose {
    position: fixed;
    /* por encima de todo el contenido de la página */
    z-index: 2147483000;
  }

  .sticker.is-lifted {
    cursor: grabbing;
  }

  .sticker.is-settling {
    transition:
      transform 420ms var(--ease-spring),
      left 220ms var(--ease-out),
      top 220ms var(--ease-out);
  }

  .sticker.is-returning {
    transition:
      transform 400ms var(--ease-out),
      left 400ms var(--ease-out),
      top 400ms var(--ease-out);
  }

  .sticker:focus-visible {
    outline: 2px solid var(--sticker-focus, var(--focus));
    outline-offset: 1px;
  }

  .sticker__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    pointer-events: none;
    /* drop-shadow y no box-shadow: la sombra sigue la silueta troquelada */
    filter: var(--sticker-shadow);
    transition: filter 200ms var(--ease-out);
  }

  .sticker__img--peel {
    visibility: hidden;
  }

  .sticker.is-lifted .sticker__img--rest {
    visibility: hidden;
  }

  .sticker.is-lifted .sticker__img--peel {
    visibility: visible;
    filter: var(--sticker-shadow-lift);
  }

  @media (prefers-reduced-motion: reduce) {
    .sticker.is-settling,
    .sticker.is-returning {
      transition-duration: 1ms;
    }
  }
</style>

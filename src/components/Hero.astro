---
import { Picture } from "astro:assets";
import DrawnButton from "./DrawnButton.astro";
import heroBg from "../assets/hero/aline-hero-img.jpg";
import pencil from "../assets/hero/aline-lapiz.webp";
import { APP_URL, INSTALL_URL } from "../config/site";
import { heroConfig } from "../config/hero";
import { getT, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getT(lang);
const firstWord = t.hero.words[0] ?? "";

const { sheet, bgSize } = heroConfig;
const cssVars = [
  `--bg-ar: ${bgSize.width / bgSize.height}`,
  `--sheet-cx: ${sheet.cx / 100}`,
  `--sheet-cy: ${sheet.cy / 100}`,
  `--sheet-w: ${sheet.w / 100}`,
  `--sheet-h: ${sheet.h / 100}`,
  `--sheet-rot: ${sheet.rotate}deg`,
  `--sheet-max: ${heroConfig.sheetMaxPx}px`,
  `--pencil-w: ${heroConfig.pencilWidthEm.desktop}em`,
  `--pencil-w-sm: ${heroConfig.pencilWidthEm.mobile}em`,
].join("; ");

// Forma del resaltador (doodles/highlight-bar.svg) y del tachado (doodles/strike-scribble.svg), animadas inline
const HIGHLIGHT = "M6 12 C 50 6, 140 8, 194 10 C 198 18, 197 28, 192 32 C 140 36, 60 34, 8 33 C 3 26, 3 18, 6 12 Z";
const STRIKE =
  "M2 22 L10 14 L16 28 L24 12 L30 30 L38 13 L44 29 L52 12 L58 30 L66 13 L72 28 L80 14 L86 27 L94 16 L98 22";
---

<section class="hero" id="top" style={cssVars} data-hero data-thread-anchor="start">
  <!-- Opción A: el escritorio pintado ya trae la hoja; el contenido se coloca encima,
       en coordenadas relativas a la imagen (config/hero.ts → sheet) -->
  <div class="hero__stage">
    <Picture
      class="hero__bg"
      src={heroBg}
      alt=""
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      widths={[640, 960, 1440, 1920, 2560]}
      sizes="(max-width: 599px) 1140px, (max-width: 1969px) 1970px, 100vw"
      quality={55}
      loading="eager"
      fetchpriority="high"
    />

    <div class="hero__sheet">
      <h1 class="hero__title">
        <span class="sr-only">{t.hero.title}</span>
        <span aria-hidden="true">
          <span class="hero__line">{t.hero.line1}</span>
          <span class="hero__line hero__line--nowrap">
            <span class="hw" data-hero-word data-words={JSON.stringify(t.hero.words)}>
              <span class="hw__ink" data-ink>
                <svg class="hw__hl" viewBox="0 0 200 40" preserveAspectRatio="none" data-hl>
                  <path d={HIGHLIGHT}></path>
                </svg>
                <span class="hw__text hand" data-text>
                  {firstWord}
                </span>
                <svg class="hw__strike" viewBox="0 0 100 40" preserveAspectRatio="none" data-strike>
                  <path d={STRIKE} vector-effect="non-scaling-stroke"></path>
                </svg>
              </span>
              <Picture
                class="hw__pencil"
                src={pencil}
                alt=""
                formats={["avif", "webp"]}
                widths={[240, 480, 720]}
                sizes="(max-width: 599px) 120px, 240px"
                quality={70}
                loading="eager"
                data-pencil
              />
            </span><span class="hero__suffix" data-suffix>{t.hero.suffix}</span>
          </span>
        </span>
      </h1>

      <p class="hero__sub">{t.hero.sub}</p>

      <div class="hero__ctas">
        <DrawnButton href={APP_URL} variant="primary" size="lg">
          {t.cta.open}
        </DrawnButton>
        <DrawnButton href={INSTALL_URL} variant="secondary" size="lg">
          {t.cta.installApp}
        </DrawnButton>
        <p class="hero__runs hand">{t.hero.runsIn}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { heroConfig } from "../config/hero";

  const { timings: T, pencilTip, pencilSize, baseline, wobble, away } = heroConfig;

  const easeInOut = (p: number) => (p < 0.5 ? 2 * p * p : 1 - (-2 * p + 2) ** 2 / 2);
  const easeOut = (p: number) => 1 - (1 - p) ** 3;
  const lerp = (a: number, b: number, p: number) => a + (b - a) * p;

  function init(section: HTMLElement) {
    const word = section.querySelector<HTMLElement>("[data-hero-word]");
    const ink = section.querySelector<HTMLElement>("[data-ink]");
    const text = section.querySelector<HTMLElement>("[data-text]");
    const hl = section.querySelector<SVGElement>("[data-hl]");
    const strike = section.querySelector<SVGElement>("[data-strike]");
    const pencil = section.querySelector<HTMLImageElement>("img[data-pencil]");
    const suffix = section.querySelector<HTMLElement>("[data-suffix]");
    if (!word || !ink || !text || !hl || !strike || !pencil || !suffix) return;

    let words: string[] = [];
    try {
      words = JSON.parse(word.dataset.words ?? "[]") as string[];
    } catch {
      /* sin palabras: se queda la primera del HTML */
    }
    if (words.length < 2) return;

    let index = 0;
    const setWord = (i: number) => {
      index = i % words.length;
      text.textContent = words[index] ?? "";
    };

    /**
     * Hueco fijo para la palabra: el ancho de la más larga, en em para que escale con el titular.
     * Así el sufijo (" it out." / ".") no se mueve al cambiar de palabra.
     */
    function reserveSlot() {
      const current = text!.textContent;
      word!.style.minWidth = "";
      let max = 0;
      for (const w of words) {
        text!.textContent = w;
        max = Math.max(max, text!.offsetWidth);
      }
      text!.textContent = current;
      const fontSize = parseFloat(getComputedStyle(word!).fontSize) || 1;
      word!.style.minWidth = `${(max / fontSize).toFixed(3)}em`;
    }
    document.fonts.ready.then(reserveSlot);

    // Movimiento reducido: sin lápiz ni animación, la palabra cambia cada 2.6 s
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (reduced.matches) {
      section.classList.add("is-static");
      let timer = 0;
      const io = new IntersectionObserver(([entry]) => {
        window.clearInterval(timer);
        if (entry?.isIntersecting) timer = window.setInterval(() => setWord(index + 1), T.reducedMotionInterval);
      });
      io.observe(section);
      return;
    }

    // Fases de una palabra, en ms acumulados
    const phases = (letters: number) => {
      const write = T.writeBase + T.writePerLetter * letters;
      const p0 = T.pause;
      const p1 = p0 + write;
      const p2 = p1 + T.highlight;
      const p3 = p2 + T.hold;
      const p3b = p3 + T.approach;
      const p4 = p3b + T.strike;
      const p5 = p4 + T.fade;
      return { write, p0, p1, p2, p3, p3b, p4, p5 };
    };

    let elapsed = 0;
    let last = 0;
    let raf = 0;
    let running = false;

    function placePencil(x: number, y: number) {
      // La punta del lápiz, escalada al tamaño renderizado, cae sobre (x, y)
      const scale = pencil!.offsetWidth / pencilSize.width;
      pencil!.style.transform = `translate(${x - pencilTip.x * scale}px, ${y - pencilTip.y * scale}px)`;
    }

    function frame(now: number) {
      // dt limitado: al volver de otra pestaña no salta medio ciclo
      const dt = last ? Math.min(64, now - last) : 16;
      last = now;
      elapsed += dt;

      const letters = (words[index] ?? "").length;
      const ph = phases(letters);
      if (elapsed >= ph.p5) {
        elapsed -= ph.p5;
        setWord(index + 1);
        raf = requestAnimationFrame(frame);
        return;
      }

      const w = text!.offsetWidth;
      const h = text!.offsetHeight;
      const t = elapsed;
      const baseY = h * baseline;
      // Tras resaltar, el lápiz se aparta a la derecha del sufijo, a la altura de la línea,
      // para que el eslogan se lea entero
      const suffixEnd = suffix!.offsetLeft + suffix!.offsetWidth - word!.offsetLeft;
      const awayX = suffixEnd + h * away.x;
      const awayY = baseY + h * away.y;
      const strikeY = (e: number) => h * 0.55 + Math.sin(e * Math.PI * 14) * h * 0.14;

      let reveal = 0;
      let highlight = 0;
      let strikeP = 0;
      let opacity = 1;
      let hx = 0;
      let hy = baseY;

      if (t < ph.p0) {
        // Pausa: el lápiz espera al inicio
      } else if (t < ph.p1) {
        const p = (t - ph.p0) / ph.write;
        const e = easeInOut(p);
        reveal = e;
        const cycles = Math.max(1, letters);
        hx = e * w + Math.sin(e * Math.PI * 2 * cycles * 1.3) * wobble.x * w;
        hy = baseY - Math.abs(Math.sin(e * Math.PI * cycles)) * wobble.y * h * 2 + wobble.y * h;
      } else if (t < ph.p2) {
        const p = (t - ph.p1) / T.highlight;
        const e = easeInOut(p);
        reveal = 1;
        highlight = easeOut(p);
        hx = lerp(w, awayX, e);
        hy = lerp(baseY, awayY, e) - Math.sin(Math.PI * e) * h * 0.25;
      } else if (t < ph.p3) {
        const s = (t - ph.p2) / 1000;
        reveal = 1;
        highlight = 1;
        hx = awayX + Math.sin(s * 2.2) * h * 0.04;
        hy = awayY + Math.sin(s * 3.1) * h * 0.05;
      } else if (t < ph.p3b) {
        // Se acerca con calma, en arco, al inicio del tachado
        const e = easeInOut((t - ph.p3) / T.approach);
        reveal = 1;
        highlight = 1;
        hx = lerp(awayX, 0, e);
        hy = lerp(awayY, strikeY(0), e) - Math.sin(Math.PI * e) * h * 0.3;
      } else if (t < ph.p4) {
        const e = easeInOut((t - ph.p3b) / T.strike);
        reveal = 1;
        highlight = 1;
        strikeP = e;
        hx = e * w;
        hy = strikeY(e);
      } else {
        const p = easeInOut((t - ph.p4) / T.fade);
        reveal = 1;
        highlight = 1;
        strikeP = 1;
        opacity = 1 - p;
        hx = lerp(w, 0, p);
        hy = lerp(h * 0.55, baseY, p);
      }

      text!.style.clipPath = `inset(-40% ${(1 - reveal) * 100}% -40% -10%)`;
      hl!.style.clipPath = `inset(-20% ${(1 - highlight) * 100}% -20% 0)`;
      // clip-path y no stroke-dashoffset: con non-scaling-stroke, Chrome ignora pathLength en el guion
      strike!.style.clipPath = `inset(-50% ${(1 - strikeP) * 100}% -50% -5%)`;
      ink!.style.opacity = String(opacity);
      placePencil(hx, hy);

      raf = requestAnimationFrame(frame);
    }

    function start() {
      if (running) return;
      running = true;
      last = 0;
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    section.classList.add("is-animated");
    const io = new IntersectionObserver(([entry]) => (entry?.isIntersecting ? start() : stop()));

    // Espera a las fuentes para medir bien la primera palabra
    document.fonts.ready.then(() => {
      section.classList.add("is-ready");
      io.observe(section);
    });
  }

  for (const section of document.querySelectorAll<HTMLElement>("[data-hero]")) init(section);
</script>

<style>
  /*
   * Opción A. El fondo escala para que la hoja pintada mida --paper de ancho,
   * y nunca menos que el ancho de la ventana. La sección recorta alrededor de la hoja.
   */
  .hero {
    z-index: 1;
    --paper: min(92vw, var(--sheet-max), calc((100svh - 140px) * 0.75));
    --sw: max(100vw, calc(var(--paper) / var(--sheet-w)));
    --sh: calc(var(--sw) / var(--bg-ar));
    position: relative;
    overflow: hidden;
    /* alto de la hoja girada + margen */
    height: calc(var(--sw) * var(--sheet-w) * 1.4 + 64px);
    background: #8a5a3c;
    scroll-margin-top: 76px;
  }

  .hero__stage {
    position: absolute;
    left: calc(50% - var(--sw) * var(--sheet-cx));
    top: calc(50% - var(--sh) * var(--sheet-cy));
    width: var(--sw);
    height: var(--sh);
  }

  .hero :global(.hero__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  /* El contenido, encima de la hoja pintada y girado con ella */
  .hero__sheet {
    position: absolute;
    left: calc(var(--sheet-cx) * 100%);
    top: calc(var(--sheet-cy) * 100%);
    width: calc(var(--sheet-w) * 100%);
    height: calc(var(--sheet-h) * 100%);
    display: flex;
    flex-direction: column;
    justify-content: center;
    container-type: inline-size;
    transform: translate(-50%, -50%) rotate(var(--sheet-rot));
  }

  .hero__sheet > * {
    /* cqi se resuelve contra la hoja: todo escala con ella */
    min-width: 0;
    padding-inline: 8cqi;
  }

  .hero__title {
    position: relative;
    z-index: 1;
    margin: 0 0 4cqi;
    font-weight: 900;
    font-size: 12.5cqi;
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .hero__line {
    display: block;
  }

  .hero__line--nowrap {
    white-space: nowrap;
  }

  /* Palabra manuscrita: a 1em, "Resuélvelo." tiene que caber en el ancho de la hoja */
  .hw {
    position: relative;
    display: inline-block;
    font-size: 1em;
    line-height: 1;
    letter-spacing: 0;
  }

  .hero__suffix {
    white-space: pre;
  }

  .hw__ink {
    position: relative;
    display: inline-block;
  }

  .hw__text {
    position: relative;
    display: inline-block;
    padding-right: 0.04em;
  }

  .hw__hl {
    position: absolute;
    left: -0.06em;
    right: -0.06em;
    top: 52%;
    width: calc(100% + 0.12em);
    height: 0.4em;
    max-width: none;
    overflow: visible;
    fill: var(--brand);
    transform: rotate(-1.5deg);
  }

  .hw__strike {
    position: absolute;
    left: -0.04em;
    top: 32%;
    width: calc(100% + 0.08em);
    height: 0.42em;
    max-width: none;
    overflow: visible;
    pointer-events: none;
  }

  .hw__strike path {
    fill: none;
    stroke: var(--text-primary);
    stroke-width: 5px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Oculto hasta la fase de tachar (y siempre sin JS o con movimiento reducido) */
  .hw__strike {
    clip-path: inset(-50% 100% -50% -5%);
  }

  /* El lápiz */
  .hw :global(.hw__pencil) {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    width: var(--pencil-w);
    max-width: none;
    height: auto;
    pointer-events: none;
    user-select: none;
    opacity: 0;
    will-change: transform;
  }

  .hero.is-ready :global(.hw__pencil) {
    opacity: 1;
    transition: opacity 300ms var(--ease-out);
  }

  /* Hasta que arranca la isla, la palabra se ve con su resaltado */
  .hero.is-animated .hw__text {
    clip-path: inset(-40% 100% -40% -10%);
  }

  .hero.is-animated .hw__hl {
    clip-path: inset(-20% 100% -20% 0);
  }

  .hero.is-static :global(.hw__pencil) {
    display: none;
  }

  .hero__sub {
    position: relative;
    margin: 0 0 5cqi;
    color: var(--text-secondary);
    font-size: max(14px, 3.6cqi);
    line-height: 1.5;
  }

  .hero__ctas {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 3cqi 3cqi;
  }

  .hero__ctas :global(.db) {
    min-height: max(44px, 10.5cqi);
    padding: 0 5cqi;
    font-size: max(14px, 3.6cqi);
  }

  .hero__runs {
    flex-basis: 100%;
    margin: 0;
    color: var(--text-accent);
    font-size: max(15px, 4cqi);
    line-height: 1.2;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero :global(.hw__pencil) {
      display: none;
    }
  }

  @media (max-width: 599.98px) {
    .hw :global(.hw__pencil) {
      width: var(--pencil-w-sm);
    }
  }
</style>

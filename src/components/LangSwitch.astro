---
import { otherLang, type Lang } from "../i18n";
import { getT } from "../i18n";

interface Props {
  lang: Lang;
  /** "hand": escrito a mano en la hoja de libreta del nav. "dark": sobre la tinta del footer. */
  variant?: "ui" | "hand" | "dark";
  /** Página actual dentro del idioma ("install/"): el cambio de idioma lleva a la misma página. */
  path?: string;
}

const { lang, variant = "ui", path = "" } = Astro.props;
const target = otherLang(lang);
const t = getT(lang);
---

<a
  class:list={["lang", `lang--${variant}`]}
  href={`/${target}/${path}`}
  hreflang={target}
  lang={target}
  data-lang={target}
  aria-label={t.lang.aria}
>
  <span class:list={["lang__opt", { "is-active": lang === "en" }]}>EN</span>
  <span class="lang__sep" aria-hidden="true">
    /
  </span>
  <span class:list={["lang__opt", { "is-active": lang === "es" }]}>ES</span>
</a>

<script>
  const ONE_YEAR = 60 * 60 * 24 * 365;
  for (const link of document.querySelectorAll<HTMLAnchorElement>("a.lang[data-lang]")) {
    link.addEventListener("click", () => {
      // Secure solo en https: en http local (pnpm dev) el navegador descartaría la cookie
      const secure = location.protocol === "https:" ? "; Secure" : "";
      document.cookie = `lang=${link.dataset.lang}; Max-Age=${ONE_YEAR}; Path=/; SameSite=Lax${secure}`;
    });
  }
</script>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    min-width: 44px;
    padding: 0 6px;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  .lang__opt.is-active {
    color: var(--text-primary);
    font-weight: 900;
  }

  .lang__sep {
    color: var(--border-soft);
    font-weight: 600;
  }

  /* A mano, sobre el renglón de la libreta */
  .lang--hand {
    font-family: var(--font-hand);
    font-size: 21px;
    font-weight: 400;
    gap: 6px;
  }

  .lang--hand .lang__opt.is-active {
    font-weight: 400;
    text-decoration: underline;
    text-decoration-color: #f5c842;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }

  .lang--hand .lang__sep {
    color: var(--text-secondary);
    font-weight: 400;
  }

  /* Sobre el fondo tinta del footer */
  .lang--dark {
    color: var(--dark-text-2);
    font-size: 14px;
    font-weight: 700;
  }

  .lang--dark .lang__opt.is-active {
    color: var(--brand);
    font-weight: 800;
  }

  .lang--dark .lang__sep {
    color: var(--dark-text-2);
  }

  @media (hover: hover) {
    .lang--dark:hover .lang__opt:not(.is-active) {
      color: var(--dark-text);
    }
  }

  @media (hover: hover) {
    .lang:hover .lang__opt:not(.is-active) {
      color: var(--text-primary);
    }
  }
</style>

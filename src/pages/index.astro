---
/*
 * Fallback si la página se sirve sin el middleware de Cloudflare:
 * mismo criterio que functions/_middleware.ts, pero con navigator.languages.
 */
import "../styles/global.css";
import { SITE_URL } from "../config/site";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>aline</title>
    <link rel="canonical" href={new URL("/en/", SITE_URL).href} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", SITE_URL).href} />
    <link rel="alternate" hreflang="es" href={new URL("/es/", SITE_URL).href} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", SITE_URL).href} />
    <script is:inline>
      (function () {
        const m = document.cookie.match(/(?:^|;\s*)lang=(en|es)(?:;|$)/);
        let lang = m ? m[1] : null;
        if (!lang) {
          const list = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || "en"];
          lang = "en";
          for (let i = 0; i < list.length; i++) {
            const base = String(list[i]).toLowerCase().split("-")[0];
            if (base === "en" || base === "es") {
              lang = base;
              break;
            }
          }
        }
        location.replace("/" + lang + "/");
      })();
    </script>
  </head>
  <body>
    <p style="padding: 24px">
      <a href="/en/">English</a> · <a href="/es/" lang="es">Español</a>
    </p>
  </body>
</html>
